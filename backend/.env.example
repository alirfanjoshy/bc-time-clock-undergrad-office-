NODE_ENV=development
PORT=4000
# Optional: serve the built web app from this directory (relative to backend).
# WEB_DIST_PATH=../frontend/desktop/dist
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bc_timeclock
JWT_ACCESS_SECRET=replace-with-secure-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:19006
ADMIN_REGISTRATION_CODE=BCAdminSetup2026!

# Password reset: set the browser URL reachable from employees' phones.
# PASSWORD_RESET_URL=https://timeclock.example.edu/
# MAIL_FROM=BC Time Clock <timeclock@example.edu>
# Choose Resend OR SMTP; keep credentials in backend/.env only.
# RESEND_API_KEY=your-api-key
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=timeclock@example.edu
# SMTP_PASSWORD=your-smtp-password
